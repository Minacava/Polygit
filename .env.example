# Copy to .env and fill in the provider / forge tokens you use.
# Never commit real API keys or tokens.

# LLM providers (optional — only needed when TM has no match)
# Set defaultProvider in .tmconfig.json or pass --provider on translate.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Local models via Ollama (install + run ollama serve; no API key)
# Prefer: polygit models use ollama <tag>  (saves to .tmconfig.json)
# OLLAMA_HOST=http://127.0.0.1:11434
# POLYGIT_OLLAMA_MODEL=llama3.2

# Hugging Face Inference Providers (cloud)
HF_TOKEN=
# HUGGINGFACE_TOKEN=   # alias for HF_TOKEN
# Prefer: polygit models use huggingface <org/model>
# POLYGIT_HF_MODEL=meta-llama/Meta-Llama-3-8B-Instruct

# Optional model overrides for cloud providers (or use `polygit models use`)
# POLYGIT_CLAUDE_MODEL=claude-3-5-haiku-latest
# POLYGIT_OPENAI_MODEL=gpt-4o-mini

# Forge tokens for `polygit publish` (pick the host you use)
# GitHub: classic PAT or fine-grained token with pull-requests:write (and contents:write to push)
GITHUB_TOKEN=
# GH_TOKEN=   # accepted as an alias for GITHUB_TOKEN

# GitLab: personal access token with api scope (gitlab.com or self-hosted)
GITLAB_TOKEN=
# GL_TOKEN=   # accepted as an alias for GITLAB_TOKEN
