# Copy to .env and fill in the provider / forge tokens you use.
# Never commit real API keys or tokens.

# LLM providers (optional — only needed when TM has no match)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Forge tokens for `polygit publish` (pick the host you use)
# GitHub: classic PAT or fine-grained token with pull-requests:write (and contents:write to push)
GITHUB_TOKEN=
# GH_TOKEN=   # accepted as an alias for GITHUB_TOKEN

# GitLab: personal access token with api scope (gitlab.com or self-hosted)
GITLAB_TOKEN=
# GL_TOKEN=   # accepted as an alias for GITLAB_TOKEN
