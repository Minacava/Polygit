{
  "name": "polygit",
  "version": "1.0.0",
  "description": "Local-first CLI for assisted translation with translation memory, glossary propagation, Git integration, and LLM providers.",
  "license": "MIT",
  "author": "Marina Camacho",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Minacava/Polygit.git"
  },
  "bugs": {
    "url": "https://github.com/Minacava/Polygit/issues"
  },
  "homepage": "https://github.com/Minacava/Polygit#readme",
  "keywords": [
    "translation",
    "i18n",
    "cli",
    "translation-memory",
    "glossary",
    "git",
    "llm",
    "local-first",
    "cat-tool",
    "polygit"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "polygit": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    ".env.example"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
"prepublishOnly": "npm run typecheck && npm test && npm run security:audit",
    "security:audit": "npm audit --omit=dev",
    "test": "npm run build && node --test 'test/**/*.test.js'",
    "pack:check": "npm pack --dry-run"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "commander": "^13.1.0",
    "dotenv": "^17.4.2",
    "simple-git": "^3.36.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.20.2",
    "typescript": "^5.8.2"
  }
}
